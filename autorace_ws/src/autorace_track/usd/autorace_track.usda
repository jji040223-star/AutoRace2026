#usda 1.0
(
    defaultPrim = "AutoRaceTrack"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "AutoRaceTrack" (
    customData = {
        dictionary autorace = {
            string frame = "origin = mat bottom-left corner, +x = drawing right, +y = drawing up, z = 0 is mat top"
            double2 size_m = (10, 6)
            string source = "2026Track.dxf"
            double3 start_pose = (1.01, 5.58, 0)
        }
    }
    kind = "assembly"
)
{
    def Scope "Looks"
    {
        def Material "Mat"
        {
            token outputs:surface.connect = </AutoRaceTrack/Looks/Mat/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03688945, 0.034339808, 0.027320892)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Paint_white"
        {
            token outputs:surface.connect = </AutoRaceTrack/Looks/Paint_white/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7379104, 0.7011019, 0.59061885)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Paint_yellow"
        {
            token outputs:surface.connect = </AutoRaceTrack/Looks/Paint_yellow/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7835378, 0.40197778, 0.05612849)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Paint_black"
        {
            token outputs:surface.connect = </AutoRaceTrack/Looks/Paint_black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0056053917, 0.0056053917, 0.0056053917)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Venue"
        {
            token outputs:surface.connect = </AutoRaceTrack/Looks/Venue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2541521, 0.24228112, 0.2158605)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Scope "Physics"
    {
        def Material "FloorMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.8
            uniform token physxMaterial:frictionCombineMode = "average"
        }

        def Plane "FloorCollider" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double length = 12
            rel material:binding:physics = </AutoRaceTrack/Physics/FloorMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token purpose = "guide"
            double width = 16
            double3 xformOp:translate = (5, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "Ground"
    {
        def Mesh "Mat" (
            prepend apiSchemas = ["MaterialBindingAPI", "SemanticsLabelsAPI:class"]
        )
        {
            uniform bool doubleSided = 0
            float3[] extent = [(0, 0, 0), (10, 6, 0)]
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 1, 0, 3]
            rel material:binding = </AutoRaceTrack/Looks/Mat>
            normal3f[] normals = [(0, 0, 1)] (
                interpolation = "constant"
            )
            point3f[] points = [(0, 0, 0), (10, 6, 0), (0, 6, 0), (10, 0, 0)]
            color3f[] primvars:displayColor = [(0.03688945, 0.034339808, 0.027320892)]
            custom token[] semantics:labels:class = ["track_floor"]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Venue" (
            prepend apiSchemas = ["MaterialBindingAPI", "SemanticsLabelsAPI:class"]
        )
        {
            uniform bool doubleSided = 0
            float3[] extent = [(-3, -3, -0.003), (13, 9, -0.003)]
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 1, 0, 3]
            rel material:binding = </AutoRaceTrack/Looks/Venue>
            normal3f[] normals = [(0, 0, 1)] (
                interpolation = "constant"
            )
            point3f[] points = [(-3, -3, -0.003), (13, 9, -0.003), (-3, 9, -0.003), (13, -3, -0.003)]
            color3f[] primvars:displayColor = [(0.2541521, 0.24228112, 0.2158605)]
            custom token[] semantics:labels:class = ["venue_floor"]
            uniform token subdivisionScheme = "none"
        }
    }

